{
  "name": "shapeshift",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "pnpm --filter @shapeshift/frontend dev",
    "dev:offline": "pnpm --filter @shapeshift/frontend dev:offline",
    "build": "pnpm --filter @shapeshift/frontend build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "e2e": "pnpm --filter @shapeshift/frontend e2e",
    "deploy": "pnpm --filter @shapeshift/frontend deploy",
    "db:migrate": "pnpm --filter @shapeshift/backend db:migrate",
    "db:migrate:remote": "pnpm --filter @shapeshift/backend db:migrate:remote"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.72.1",
    "typescript": "~5.8.3"
  }
}
