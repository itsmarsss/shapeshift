{
  "name": "@shapeshift/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "dev:offline": "CF_REMOTE_BINDINGS=0 vite",
    "build": "tsc -b && vite build",
