    "@react-three/fiber": "^9.8.2",
    "@types/styled-components": "^5.1.36",
    "immer": "^10.2.0",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "styled-components": "^6.6.0",
    "three": "^0.180.0",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.17",
    "three-stdlib": "^2.36.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16",
    "@shapeshift/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
