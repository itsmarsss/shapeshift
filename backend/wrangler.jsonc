{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shapeshift",
  // The ShapeShift Cloudflare account, so a deploy can't land in another one.
  "account_id": "5bc3b9b0633d9e07fc0908e600147b08",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/s/*"]
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "shapeshift", "database_id": "bed9dbc7-8c71-47b7-a6f5-582704c9a092", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "SCENES", "bucket_name": "shapeshift-scenes" }],
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "shapeshift_events" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    "AGENT_MODEL": "claude-opus-5-5",
    "AGENT_EFFORT": "medium"
  },
  "observability": { "enabled": true },
  "routes": [{ "pattern": "tryshapeshift.com", "custom_domain": true }]
}
